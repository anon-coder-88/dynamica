{
  "name": "dynamica-utility-mvp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:contracts": "forge test -vv",
    "check:languages": "node scripts/language-share.mjs",
    "abi": "node scripts/export-abi.mjs",
    "check:sdk": "tsc -p packages/sdk/tsconfig.json",
    "test:sdk": "node --experimental-transform-types --test packages/sdk/test/*.test.ts",
    "journey": "npm --prefix chain run journey",
    "format:contracts": "forge fmt --check",
    "test:foundry": "forge test -vv"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "viem": "2.56.9",
    "radix-ui": "1.6.7",
    "lucide-react": "1.31.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
