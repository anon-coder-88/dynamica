NEXT_PUBLIC_DYNAMICA_ASSET_ADDRESS=
NEXT_PUBLIC_DYNAMICA_VAULT_ADDRESS=
# For chain interaction and Python read helper:
DYNAMICA_VAULT_ADDRESS=
DYNAMICA_ACCOUNT_ADDRESS=
DYNAMICA_ACTION=status
DYNAMICA_AMOUNT=1
