# Robinhood Testnet only. Obtain test ETH for gas before deploying.
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Keep this private. Use a throwaway testnet account; never commit .env.
DEPLOYER_PRIVATE_KEY=
